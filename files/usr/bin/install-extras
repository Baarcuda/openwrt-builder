#!/bin/sh
set -eu

ARCH="aarch64_cortex-a53"

log() { echo "==> $1"; }
err() { echo "!! Ошибка: $1" >&2; exit 1; }

install_mosdns() {
    log "Установка MosDNS v5 + LuCI (официальный мульти-архитектурный скрипт)..."
    INSTALL_URL="https://raw.githubusercontent.com/sbwml/luci-app-mosdns/v5/install.sh"
    TMP_SH=$(mktemp)
    
    if curl -sLf --connect-timeout 10 -m 60 "$INSTALL_URL" -o "$TMP_SH"; then
        sh "$TMP_SH" "$@"
        rm -f "$TMP_SH"
        /etc/init.d/mosdns enable 2>/dev/null || true
        log "MosDNS успешно установлен. Доступен в LuCI: 'Службы' -> 'MosDNS'."
    else
        rm -f "$TMP_SH"
        err "Не удалось загрузить скрипт установки MosDNS с GitHub"
    fi
}

install_fptn() {
    log "Установка FPTN клиента (OpenWrt 25.12 APK)..."
    TMP_DIR=$(mktemp -d)

    # Получаем последний стабильный тег с GitHub, при сбое сети используем fallback 0.4.6
    FPTN_TAG=$(curl -sIL -o /dev/null -w "%{url_effective}" --connect-timeout 5 -m 15 https://github.com/fptn-project/fptn/releases/latest 2>/dev/null | tr -d "\r\n" | awk -F/ '{print $NF}')
    [ -n "$FPTN_TAG" ] || FPTN_TAG="0.4.6"

    FPTN_APK="https://github.com/fptn-project/fptn/releases/download/${FPTN_TAG}/fptn-client-${FPTN_TAG}-openwrt-25.12.x-${ARCH}.apk"
    log "Загрузка FPTN ${FPTN_TAG} (.apk для 25.12, архитектура: ${ARCH})..."

    if curl -sLf --connect-timeout 10 -m 300 "$FPTN_APK" -o "$TMP_DIR/fptn.apk"; then
        log "Установка через нативный apk..."
        apk add --allow-untrusted "$TMP_DIR/fptn.apk"
    else
        log "Fallback: загрузка IPK для 24.10..."
        FPTN_IPK="https://github.com/fptn-project/fptn/releases/download/${FPTN_TAG}/fptn-client-${FPTN_TAG}-openwrt-24.10.x-${ARCH}.ipk"
        if ! curl -sLf --connect-timeout 10 -m 300 "$FPTN_IPK" -o "$TMP_DIR/fptn.ipk"; then
            rm -rf "$TMP_DIR"
            err "Не удалось загрузить пакет FPTN с GitHub"
        fi
        ( cd "$TMP_DIR" && ( ar -x fptn.ipk 2>/dev/null || tar -xzf fptn.ipk 2>/dev/null || true ) )
        if [ -f "$TMP_DIR/data.tar.gz" ]; then
            tar -xzf "$TMP_DIR/data.tar.gz" -C /
        elif [ -f "$TMP_DIR/data.tar" ]; then
            tar -xf "$TMP_DIR/data.tar" -C /
        fi
    fi
    rm -rf "$TMP_DIR"

    chmod 0755 /usr/bin/fptn-client-cli 2>/dev/null || true
    chmod 0755 /usr/bin/fptn-tcp-probe 2>/dev/null || true
    [ -f /etc/init.d/fptn ] && chmod 0755 /etc/init.d/fptn && /etc/init.d/fptn enable 2>/dev/null || true

    log "FPTN успешно установлен. Доступен в LuCI: 'Службы' -> 'FPTN'."
}

install_lalune() {
    log "Установка LaLune (csqtt-client + backend на :1062)..."
    INSTALL_URL="https://raw.githubusercontent.com/Endlad2/LaLune/main/Installer/openwrt.sh"
    TMP_SH=$(mktemp)
    
    if curl -sLf --connect-timeout 10 -m 60 "$INSTALL_URL" -o "$TMP_SH"; then
        sh "$TMP_SH"
        rm -f "$TMP_SH"
    else
        rm -f "$TMP_SH"
        err "Не удалось загрузить скрипт установки LaLune с GitHub"
    fi

    log "Регистрация службы автозагрузки /etc/init.d/lalune..."
    cat << 'EOF' > /etc/init.d/lalune
#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG="/root/.la-lune/lalune-openwrt-backend"

start_service() {
    [ -x "$PROG" ] || return 1
    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
EOF
    chmod 0755 /etc/init.d/lalune
    /etc/init.d/lalune enable 2>/dev/null || true

    log "LaLune успешно установлен в ~/.la-lune/ и зарегистрирован в автозагрузке (порт :1062)."
    log "Подключение в UI: 'Настройки' -> 'Экспериментальное' -> 'Роутеры' -> 'Подключить OpenWRT'."
}

install_ssclash() {
    log "Установка SSClash-Go (Mihomo core + UI на :9091)..."
    INSTALL_URL="https://github.com/zerolabnet/SSClash-Go/raw/refs/heads/main/install-ssclash-go.sh"
    TMP_SH=$(mktemp)
    
    if curl -sLf --connect-timeout 10 -m 60 "$INSTALL_URL" -o "$TMP_SH"; then
        ash "$TMP_SH" "$@"
        rm -f "$TMP_SH"
        
        # Патч init-скрипта для гарантированной работы TLS через CLI-аргументы
        if [ -f /etc/init.d/ssclash ]; then
            sed -i 's|procd_set_param command "$PROG" serve|if [ -f "$TLS_CERT" ] \&\& [ -f "$TLS_KEY" ]; then procd_set_param command "$PROG" serve --tls-cert "$TLS_CERT" --tls-key "$TLS_KEY"; else procd_set_param command "$PROG" serve; fi|' /etc/init.d/ssclash 2>/dev/null || true
            /etc/init.d/ssclash restart 2>/dev/null || true
        fi
        
        log "SSClash-Go успешно установлен. Панель управления доступна на порту :9091."
    else
        rm -f "$TMP_SH"
        err "Не удалось загрузить скрипт установки SSClash-Go с GitHub"
    fi
}

install_netbird() {
    log "Установка NetBird Mesh VPN + LuCI (okk.sh)..."
    INSTALL_URL="https://luci-app-netbird.okk.sh/install.sh"
    TMP_SH=$(mktemp)
    
    if curl -sLf --connect-timeout 10 -m 180 "$INSTALL_URL" -o "$TMP_SH"; then
        sh "$TMP_SH" "$@"
        rm -f "$TMP_SH"
        log "NetBird успешно установлен. Доступен в LuCI: 'Службы' -> 'NetBird'."
    else
        rm -f "$TMP_SH"
        err "Не удалось загрузить скрипт установки NetBird с $INSTALL_URL"
    fi
}

case "${1:-}" in
    mosdns)
        shift
        install_mosdns "$@"
        ;;
    fptn)
        shift
        install_fptn "$@"
        ;;
    lalune)
        shift
        install_lalune "$@"
        ;;
    ssclash|ssclashgo)
        shift
        install_ssclash "$@"
        ;;
    netbird)
        shift
        install_netbird "$@"
        ;;
    all)
        install_mosdns
        install_fptn
        install_lalune
        install_ssclash
        install_netbird
        ;;
    *)
        echo "Использование: install-extras <mosdns|fptn|lalune|ssclash|netbird|all> [параметры]"
        exit 1
        ;;
esac

# Применяем изоляцию ядер CPU (smp-tune) для свежеустановленных процессов
if [ -x /etc/init.d/smp-tune ]; then
    /etc/init.d/smp-tune restart >/dev/null 2>&1 || true
fi
