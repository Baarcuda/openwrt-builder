#!/bin/sh
set -eu

ARCH="aarch64_cortex-a53"

log() { echo "==> $1"; }
err() { echo "!! Ошибка: $1" >&2; exit 1; }

install_mosdns() {
    log "Установка MosDNS v5 + LuCI..."
    INSTALL_URL="https://raw.githubusercontent.com/sbwml/luci-app-mosdns/v5/install.sh"
    TMP_SH=$(mktemp)
    if curl -sLf --connect-timeout 10 -m 60 "$INSTALL_URL" -o "$TMP_SH"; then
        sh "$TMP_SH" "$@"
        rm -f "$TMP_SH"
        /etc/init.d/mosdns enable 2>/dev/null || true
    else
        rm -f "$TMP_SH"
        err "Не удалось загрузить MosDNS"
    fi
}

install_fptn() {
    log "Установка FPTN клиента (OpenWrt 25.12 APK)..."
    TMP_DIR=$(mktemp -d)
    FPTN_TAG=$(curl -sIL -o /dev/null -w "%{url_effective}" --connect-timeout 5 -m 15 \
        https://github.com/fptn-project/fptn/releases/latest 2>/dev/null | tr -d "\r\n" | awk -F/ '{print $NF}')
    [ -n "$FPTN_TAG" ] || FPTN_TAG="0.4.6"
    FPTN_APK="https://github.com/fptn-project/fptn/releases/download/${FPTN_TAG}/fptn-client-${FPTN_TAG}-openwrt-25.12.x-${ARCH}.apk"
    if curl -sLf --connect-timeout 10 -m 300 "$FPTN_APK" -o "$TMP_DIR/fptn.apk"; then
        apk add --allow-untrusted "$TMP_DIR/fptn.apk"
    else
        err "Не удалось загрузить FPTN"
    fi
    rm -rf "$TMP_DIR"
    [ -f /etc/init.d/fptn ] && chmod 0755 /etc/init.d/fptn && /etc/init.d/fptn enable 2>/dev/null || true
}

install_csqtt() {
    log "Установка CSQTT v2 + LuCI (OpenWrt 25.12 APK)..."
    INSTALL_URL="https://raw.githubusercontent.com/starkugz/csqtt-openwrt/main/install-csqtt.sh"
    TMP_SH=$(mktemp)
    if curl -sLf --connect-timeout 10 -m 60 "$INSTALL_URL" -o "$TMP_SH"; then
        # Исправление распознавания ветки 25.12-SNAPSHOT через дефис
        sed -i 's/"$OW_APK"\.\*/"$OW_APK"\*/g' "$TMP_SH"
        ash "$TMP_SH" "$@"
        rm -f "$TMP_SH"
    else
        rm -f "$TMP_SH"
        err "Не удалось загрузить установщик CSQTT"
    fi
}

install_ssclash() {
    log "Установка SSClash-Go..."
    INSTALL_URL="https://github.com/zerolabnet/SSClash-Go/raw/refs/heads/main/install-ssclash-go.sh"
    TMP_SH=$(mktemp)
    if curl -sLf --connect-timeout 10 -m 60 "$INSTALL_URL" -o "$TMP_SH"; then
        ash "$TMP_SH" "$@"
        rm -f "$TMP_SH"
        if [ -f /etc/init.d/ssclash ]; then
            sed -i 's|procd_set_param command "$PROG" serve|if [ -f "$TLS_CERT" ] \&\& [ -f "$TLS_KEY" ]; then procd_set_param command "$PROG" serve --tls-cert "$TLS_CERT" --tls-key "$TLS_KEY"; else procd_set_param command "$PROG" serve; fi|' \
                /etc/init.d/ssclash 2>/dev/null || true
            /etc/init.d/ssclash restart 2>/dev/null || true
        fi
    else
        rm -f "$TMP_SH"
        err "Не удалось загрузить SSClash"
    fi
}

install_netbird() {
    log "Установка NetBird..."
    INSTALL_URL="https://luci-app-netbird.okk.sh/install.sh"
    TMP_SH=$(mktemp)
    if curl -sLf --connect-timeout 10 -m 180 "$INSTALL_URL" -o "$TMP_SH"; then
        sh "$TMP_SH" "$@"
        rm -f "$TMP_SH"
        if [ -f /etc/init.d/netbird ]; then
            sed -i 's|procd_set_param env NB_STATE_DIR|procd_append_param env GOMEMLIMIT="45MiB"\n        procd_append_param env GOGC="75"\n        procd_set_param env NB_STATE_DIR|' /etc/init.d/netbird 2>/dev/null || true
        fi
    else
        rm -f "$TMP_SH"
        err "Не удалось загрузить NetBird"
    fi
}

case "${1:-}" in
    mosdns)  shift; install_mosdns  "$@" ;;
    fptn)    shift; install_fptn    "$@" ;;
    csqtt)   shift; install_csqtt   "$@" ;;
    ssclash|ssclashgo) shift; install_ssclash "$@" ;;
    netbird) shift; install_netbird "$@" ;;
    all)     install_mosdns; install_fptn; install_csqtt; install_ssclash; install_netbird ;;
    *)       echo "Использование: $0 <mosdns|fptn|csqtt|ssclash|netbird|all>"
             exit 1 ;;
esac

[ -x /etc/init.d/smp-tune ] && /etc/init.d/smp-tune restart >/dev/null 2>&1 || true
