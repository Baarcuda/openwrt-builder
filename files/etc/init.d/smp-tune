#!/bin/sh /etc/rc.common

START=99

boot() {
    start
}

restart() {
    start
}

start() {
    # 0. Отключаем irqbalance, чтобы исключить сброс настроек affinity планировщиком
    if [ -x /etc/init.d/irqbalance ]; then
        /etc/init.d/irqbalance stop >/dev/null 2>&1 || true
        /etc/init.d/irqbalance disable >/dev/null 2>&1 || true
    fi

    CORES=$(grep -c ^processor /proc/cpuinfo 2>/dev/null || echo 1)

    if [ "$CORES" -ge 4 ]; then
        # 4 ядра (AX3600): Сеть и Wi-Fi на CPU 0,1 (RPS=3, IRQ чередование 1/2); Приложения на CPU 2,3 (маска c)
        NET_MASK="3"
        APP_MASK="c"
    elif [ "$CORES" -ge 2 ]; then
        # 2 ядра (AX6000 / AX6S): Сеть на CPU 0 (маска 1); Приложения на CPU 1 (маска 2)
        NET_MASK="1"
        APP_MASK="2"
    else
        NET_MASK="1"
        APP_MASK="1"
    fi

    # 1. Аппаратные прерывания Ethernet и Wi-Fi (ARM64 GIC требует одиночное ядро: чередуем 1 и 2 для 4 ядер)
    i=0
    for irq in $(awk -F: '/ath11k|mt76|edma|eth|wbm2host|reo2host|reo2ost|rxdma/ {print $1}' /proc/interrupts 2>/dev/null | tr -d ' '); do
        if [ -f "/proc/irq/$irq/smp_affinity" ]; then
            if [ "$CORES" -ge 4 ]; then
                if [ $((i % 2)) -eq 0 ]; then
                    echo 1 > "/proc/irq/$irq/smp_affinity" 2>/dev/null || true
                else
                    echo 2 > "/proc/irq/$irq/smp_affinity" 2>/dev/null || true
                fi
                i=$((i + 1))
            else
                echo "$NET_MASK" > "/proc/irq/$irq/smp_affinity" 2>/dev/null || true
            fi
        fi
    done

    # 2. Привязка RPS (Receive Packet Steering) для всех интерфейсов к сетевым ядрам
    for rps in /sys/class/net/*/queues/rx-*/rps_cpus; do
        [ -f "$rps" ] && echo "$NET_MASK" > "$rps" 2>/dev/null || true
    done

    # 3. Увеличение очереди передачи txqueuelen для виртуальных интерфейсов (TUN/TAP/VPN)
    for iface in clash-tun csqtt0 wt0 fptn0 tun0 awg0 wg0; do
        if [ -d "/sys/class/net/$iface" ]; then
            ip link set dev "$iface" txqueuelen 2500 2>/dev/null || true
        fi
    done

    # 4. Привязка процессов (Affinity) к выделенным ядрам приложений
    for proc in clash mihomo ssclash fptn nfqws nfqws2 netbird mosdns csqtt; do
        for pid in $(pidof "$proc" 2>/dev/null); do
            taskset -p "$APP_MASK" "$pid" 2>/dev/null || true
        done
    done
}
