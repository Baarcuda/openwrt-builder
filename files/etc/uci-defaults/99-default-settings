#!/bin/sh

# 1. Определение модели устройства и установка hostname
BOARD_NAME=$(cat /tmp/sysinfo/board_name 2>/dev/null || echo "")
case "$BOARD_NAME" in
    *ax3600*)  HN="ax3600" ;;
    *ax6000*)  HN="ax6000" ;;
    *ax6s*)    HN="ax6s" ;;
    *)         HN="OpenWrt" ;;
esac

uci set system.@system[0].hostname="$HN"
uci commit system

# 2. IP адрес LAN: 192.168.10.1 и сетевой стек
uci set network.lan.ipaddr='192.168.10.1'
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.ip6assign='60'
uci set network.globals.packet_steering='1'
uci commit network

# 3. Полное удаление wan6, DUID и исключение из фаервола
uci -q delete network.wan6
for z in $(uci -q show firewall | grep "network.*wan6" | cut -d. -f2); do
    uci -q del_list firewall.${z}.network='wan6'
done
uci -q delete dhcp.wan6
uci -q delete network.globals.duid
uci commit network
uci commit firewall
uci commit dhcp

# 4. Сервер DHCP (dnsmasq) и разгон кэша
uci set dhcp.lan.interface='lan'
uci set dhcp.lan.start='100'
uci set dhcp.lan.limit='150'
uci set dhcp.lan.leasetime='12h'
uci set dhcp.@dnsmasq[0].cachesize='2048'
uci set dhcp.@dnsmasq[0].dnsforwardmax='1000'
uci set dhcp.@dnsmasq[0].logqueries='1'
uci commit dhcp

# 5. Аппаратное и программное ускорение
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'
uci commit firewall

# 6. ZRAM компрессия LZ4 (128 МБ для AX6S, 256 МБ для остальных)
uci -q set system.@system[0].zram_comp_algo='lz4'
if [ "$HN" = "ax6s" ]; then
    uci -q set system.@system[0].zram_size_mb='128'
else
    uci -q set system.@system[0].zram_size_mb='256'
fi
uci commit system

# 7. Тема оформления LuCI
uci set luci.main.mediaurlbase='/luci-static/openwrt-2020'
uci commit luci

# 8. Отключение служб по умолчанию
for s in ssclash zapret zapret2 watchcat ddns fptn lalune collectd; do
    if [ -f "/etc/init.d/$s" ]; then
        /etc/init.d/$s disable 2>/dev/null || true
        /etc/init.d/$s stop 2>/dev/null || true
    fi
done
uci set zapret.config.enabled='0' 2>/dev/null || true
uci commit zapret 2>/dev/null || true
uci set watchcat.@watchcat[0].disabled='1' 2>/dev/null || true
uci commit watchcat 2>/dev/null || true
uci set luci_statistics.collectd.enable='0' 2>/dev/null || true
uci commit luci_statistics 2>/dev/null || true

# 9. Очистка репозиториев apk от 404 ссылок
sed -i '/\/awg\//d; /\/zapret\//d; /\/zapret2\//d; /\/netbird_luci\//d' /etc/apk/repositories.d/* /etc/apk/repositories 2>/dev/null || true

# 10. Точки монтирования fstab
[ -f /etc/config/fstab ] || block detect > /etc/config/fstab 2>/dev/null || true

# 11. Настройка Wi-Fi параметров по умолчанию (страна RU и WMM)
for r in $(uci -q show wireless | grep '=wifi-device' | cut -d. -f2 | cut -d= -f1); do
    uci set wireless.${r}.country='RU' 2>/dev/null || true
done
for i in $(uci -q show wireless | grep '=wifi-iface' | cut -d. -f2 | cut -d= -f1); do
    uci set wireless.${i}.wmm='1' 2>/dev/null || true
done
uci commit wireless 2>/dev/null || true

# 12. Полная блокировка запуска collectd
chmod -x /usr/sbin/collectd 2>/dev/null || true
rm -f /etc/rc.d/*luci_statistics* /etc/rc.d/*collectd* 2>/dev/null || true

# Немедленное применение sysctl сетевых буферов до старта демонов
sysctl -p /etc/sysctl.d/99-optimization.conf 2>/dev/null || true

exit 0

# 13. Оптимизация ядра и Go Runtime под объем памяти
if [ "$HN" = "ax6s" ]; then
    sysctl -w vm.min_free_kbytes=8192 2>/dev/null || true
    GO_MEM="40MiB"
else
    sysctl -w vm.min_free_kbytes=16384 2>/dev/null || true
    GO_MEM="64MiB"
fi

# Окружение для NetBird
mkdir -p /etc
grep -qxF "GOMEMLIMIT=" /etc/netbird.env 2>/dev/null || echo "GOMEMLIMIT=${GO_MEM}" >> /etc/netbird.env
grep -qxF "GOGC=50" /etc/netbird.env 2>/dev/null || echo "GOGC=50" >> /etc/netbird.env
grep -qxF "GODEBUG=madvdontneed=1" /etc/netbird.env 2>/dev/null || echo "GODEBUG=madvdontneed=1" >> /etc/netbird.env

# Глобальный профиль для CLI и процессов Go
mkdir -p /etc/profile.d
cat << GOENV > /etc/profile.d/golang.sh
export GOMEMLIMIT=${GO_MEM}
export GOGC=50
export GODEBUG=madvdontneed=1
GOENV
chmod +x /etc/profile.d/golang.sh

# Инъекция параметров в сервис SSClash (если установлен)
if [ -f /etc/init.d/ssclash ]; then
    sed -i "/procd_open_instance/a \        procd_set_param env GOMEMLIMIT=${GO_MEM} GOGC=50 GODEBUG=madvdontneed=1" /etc/init.d/ssclash 2>/dev/null || true
fi
